# ============================================================
# CX-O 推理服务 Docker Compose 环境变量配置
# 复制此文件为 .env 并根据需要修改
# ============================================================

# ---- LLM 推理服务配置 ----
# LLM 后端选择: vllm (支持 GGUF) 或 trtllm (高性能)
# 注意: trtllm 需要预构建引擎，vllm 可直接加载 GGUF
LLM_BACKEND=vllm
# LLM 模型路径 (vLLM 模式: GGUF 文件路径; TRT-LLM 模式: 忽略此项)
LLM_MODEL_PATH=/workspace/models/model.gguf
# TRT-LLM 引擎路径 (仅 trtllm 模式)
LLM_ENGINE_PATH=/workspace/engines
# 本地模型目录 (挂载到容器内的 /workspace/models)
LLM_MODELS_DIR=./models
# GPU 设备 ID
LLM_GPU_ID=0
# 端口映射
LLM_PORT=8080
# vLLM 参数
LLM_MAX_MODEL_LEN=4096
LLM_GPU_MEM_UTIL=0.9
LLM_DTYPE=auto
LLM_MAX_NUM_SEQS=256
LLM_PREFIX_CACHING=true
# TRT-LLM 参数
LLM_MAX_BATCH_SIZE=256
LLM_MAX_NUM_TOKENS=8192
# LoRA 参数（compose 默认值；留空=不启用 LoRA 相关配置）
LLM_ENABLE_LORA=false
LLM_BASE_LORA_PATH=/workspace/models/base_lora
LLM_MAX_LORAS=8
# 逗号分隔的 LoRA 模块列表（compose 默认为空）
LLM_LORA_MODULES=

# ---- ASR 服务配置（asr-sensevoice 服务）----
# ASR 服务端口映射（compose 默认 8005）
ASR_PORT=8005
# 在线聚类相似度阈值（cam++ 余弦；>= 阈值归簇，否则新建会话内临时簇 spk_N；compose 默认 0.65）
SPK_SIM_THRESHOLD=0.65

# ---- CXO Tuner（微调服务）----
# 微调服务端口映射（compose 默认 8300）
CXO_TUNER_PORT=8300
# 评审模型名（compose 默认为空）
# CXO_TUNER_JUDGE_MODEL=
# 基座模型名（compose 默认为空）
# CXO_TUNER_BASE_MODEL=
# vLLM 服务地址（compose 默认为空）
# CXO_TUNER_VLLM_URL=
# 训练 GPU 指定，如 0 或 0,1（compose 默认为空）
# CXO_TUNER_CUDA_DEVICES=

# ---- CX-O-SERVER 连接配置 ----
# CX-O-SERVER 连接推理服务时使用以下地址
# Docker 网络内使用服务名作为主机名
# CXO_LLM_PROVIDER=trtllm
# CXO_LLM_HOST=http://llm:8080

# ---- CX-A 管理面鉴权 ----
# 管理 API 密钥（server/api/routers/admin.py 与 gateway/server.py 读取；留空=仅开发模式放行）
ADMIN_API_KEY=change-me-admin-key

# ---- 语音流静音处理 ----
# 静音 PCM 幅度判定阈值（server/services/tts_audio_utils.py，默认 200）
SILENCE_AMPLITUDE_THRESHOLD=200
# 客户端连续静音帧跳过上限（tts_audio_utils.py，默认 5）
MAX_CONSECUTIVE_SILENCE_FRAMES_CLIENT=5

# ---- 图数据库（SQLite 后端，server/core/graph/config.py）----
# 图库文件路径（相对项目根解析，默认 data/graph.db）
GRAPH_DATABASE_PATH=data/graph.db
# 图 Schema 自动建表开关（默认 true；注意：代码真实变量名为 GRAPH_AUTO_CREATE）
GRAPH_AUTO_CREATE=true
# 连接池大小（默认 10）
GRAPH_POOL_SIZE=10
# 操作超时秒数（默认 30）
GRAPH_TIMEOUT=30

# ---- 图数据库 Weaviate 向量后端 ----
# Weaviate 服务地址（默认 http://localhost:8090）
WEAVIATE_URL=http://localhost:8090
# Weaviate API 密钥（无鉴权部署可留空）
WEAVIATE_API_KEY=
# gRPC 端口（默认 50061）
WEAVIATE_GRPC_PORT=50061
# 向量维度（默认 768）
WEAVIATE_VECTOR_DIM=768
# 批量构建大小（默认 100）
WEAVIATE_BATCH_SIZE=100

# ---- 图嵌入模型 ----
# 嵌入模型名（默认 sentence-transformers/all-MiniLM-L6-v2）
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# 嵌入批大小（默认 32）
EMBEDDING_BATCH_SIZE=32
# 推理设备 cpu/cuda（默认 cpu）
EMBEDDING_DEVICE=cpu

# ---- AnythingLLM 集成 ----
# AnythingLLM 回调鉴权密钥（server/api/routers/anythingllm.py；留空=未设置时直接放行开发模式）
ANYTHINGLLM_API_KEY=
