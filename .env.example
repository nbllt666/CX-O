# ============================================================
# CX-O 推理服务 Docker Compose 环境变量配置
# 复制此文件为 .env 并根据需要修改
# ============================================================

# ---- F5-TTS Triton 配置 ----
# F5-TTS 模型名称 (F5TTS_v1_Base | F5TTS_Base | F5TTS_v1_Small | F5TTS_Small)
F5TTS_MODEL=F5TTS_v1_Base
# GPU 设备 ID
F5TTS_GPU=0
F5TTS_GPU_ID=0
# 端口映射
F5TTS_PORT_HTTP=8000
F5TTS_PORT_GRPC=8001
F5TTS_PORT_METRICS=8002

# ---- LLM 推理服务配置 ----
# LLM 后端选择: vllm (支持 GGUF) 或 trtllm (高性能)
# 注意: trtllm 需要预构建引擎，vllm 可直接加载 GGUF
LLM_BACKEND=vllm
# LLM 模型路径 (vLLM 模式: GGUF 文件路径; TRT-LLM 模式: 忽略此项)
LLM_MODEL_PATH=/workspace/models/model.gguf
# TRT-LLM 引擎路径 (仅 trtllm 模式)
LLM_ENGINE_PATH=/workspace/engines
# 本地模型目录 (挂载到容器内的 /workspace/models)
LLM_MODELS_DIR=./models
# GPU 设备 ID
LLM_GPU_ID=0
# 端口映射
LLM_PORT=8080
# vLLM 参数
LLM_MAX_MODEL_LEN=4096
LLM_GPU_MEM_UTIL=0.9
LLM_DTYPE=auto
LLM_MAX_NUM_SEQS=256
LLM_PREFIX_CACHING=true
# TRT-LLM 参数
LLM_MAX_BATCH_SIZE=256
LLM_MAX_NUM_TOKENS=8192

# ---- CX-O-SERVER 连接配置 ----
# CX-O-SERVER 连接推理服务时使用以下地址
# Docker 网络内使用服务名作为主机名
# CXO_TTS_MODE=triton
# CXO_LLM_PROVIDER=trtllm
# CXO_LLM_HOST=http://llm:8080

# ---- Orpheus TTS 配置 (vLLM + FlashInfer) ----
# HuggingFace 模型名称（多语言，含中文）
ORPHEUS_MODEL=canopylabs/orpheus-multilingual-research-release
# HuggingFace Token（如模型需要授权访问）
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
# 物理 GPU 0（与 LLM 共享，LLM 占 9GB，Orpheus 占 8-10GB）
ORPHEUS_GPU_ID=0
# vLLM 内部端口（容器间通信）
ORPHEUS_VLLM_PORT=8003
# vLLM 推理参数（gpu-memory-utilization 0.45 避免与 LLM 争抢显存）
ORPHEUS_MAX_MODEL_LEN=4096
ORPHEUS_GPU_MEM_UTIL=0.45
ORPHEUS_DTYPE=auto
ORPHEUS_MAX_NUM_SEQS=4
# FastAPI Bridge 对外端口
ORPHEUS_TTS_PORT=5060
# SNAC 解码器设备（cpu 避免 GPU 争抢；cuda 延迟更低）
ORPHEUS_SNAC_DEVICE=cpu
# Orpheus 生成参数
ORPHEUS_TEMPERATURE=0.6
ORPHEUS_TOP_P=0.95
ORPHEUS_MAX_TOKENS=8192
