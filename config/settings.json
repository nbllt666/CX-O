{
  "services": {
    "danmaku": {
      "enabled": true
    },
    "firewall": {
      "enabled": true,
      "rules": [
        "allow 192.168.1.0/24"
      ]
    },
    "vad": {
      "enabled": true,
      "threshold": 0.6
    },
    "sensevoice_streaming": {
      "chunk_size": 2048,
      "hop_size": 512,
      "look_back": 4
    },
    "adaptive_polling": {
      "enabled": true,
      "offset_ms": 100,
      "window_size": 5,
      "min_interval_ms": 100,
      "max_interval_ms": 500
    }
  }
}