# Backend API URL (default: http://127.0.0.1:8000)
VITE_API_URL=http://127.0.0.1:8000

# WebSocket URL (default: auto-derived from VITE_API_URL)
# VITE_WS_URL=ws://127.0.0.1:8000

# Control Service URL (default: same as VITE_API_URL)
# VITE_CONTROL_SERVICE_URL=http://127.0.0.1:8000

# Voice Workstation URL (default: http://127.0.0.1:8200)
# VITE_VOICE_WS_URL=http://127.0.0.1:8200

# Electron mode: set to "true" to enable Electron-specific features
# VITE_ELECTRON=true
