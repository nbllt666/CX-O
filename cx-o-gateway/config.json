            "ref_audio_path": "d:/CX-O/cx-o-gateway/data/voice_refs/cc763bdb-b4ed-4eaf-934f-924c4499a3b5_hoshino_0key_sovits_rmvpe.wav",
            "ref_text": "我对自己的歌唱水平还是很有自信的，不过值得我开口唱诵的段落可不多。希望那些剧团里的创作者们加把劲，不要让我等太久。",
            "model_type": "F5-TTS-Triton",
            "speed": 1,
            "cross_fade_duration": 0.15,
            "emotion_enabled": true,
            "effects_enabled": true,
            "emotion_voices": {
                "normal": {
                    "ref_audio": "cc763bdb-b4ed-4eaf-934f-924c4499a3b5_hoshino_0key_sovits_rmvpe.wav",
                    "ref_text": "我对自己的歌唱水平还是很有自信的，不过值得我开口唱诵的段落可不多。希望那些剧团里的创作者们加把劲，不要让我等太久。"
                },
                "happy": {
                    "ref_audio": "cc763bdb-b4ed-4eaf-934f-924c4499a3b5_hoshino_0key_sovits_rmvpe_happy.wav",
                    "ref_text": "太棒了！今天真是美好的一天，我感到非常开心！"
                },
                "sad": {
                    "ref_audio": "cc763bdb-b4ed-4eaf-934f-924c4499a3b5_hoshino_0key_sovits_rmvpe_sad.wav",
                    "ref_text": "有些事情让人感到难过，心情有些低落。"
                },
                "angry": {
                    "ref_audio": "cc763bdb-b4ed-4eaf-934f-924c4499a3b5_hoshino_0key_sovits_rmvpe_angry.wav",
                    "ref_text": "这真是太让人气愤了，我对此非常不满！"
                },
                "surprised": {
                    "ref_audio": "cc763bdb-b4ed-4eaf-934f-924c4499a3b5_hoshino_0key_sovits_rmvpe_surprised.wav",
                    "ref_text": "哇！这真是太让人意外了，完全没想到！"
                },
                "tender": {
                    "ref_audio": "cc763bdb-b4ed-4eaf-934f-924c4499a3b5_hoshino_0key_sovits_rmvpe_tender.wav",
                    "ref_text": "亲爱的，我会一直陪伴在你身边，照顾你。"
                }
            },
