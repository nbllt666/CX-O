# CX-O Gateway 环境变量配置示例
# 复制此文件为 .env 并修改对应值

# ========================================
# Gateway 基本配置
# ========================================
CXO_GATEWAY_HOST=0.0.0.0
CXO_GATEWAY_PORT=8100
CXO_GATEWAY_LOG_LEVEL=INFO

# ========================================
# 服务 URL 配置
# ========================================
# CXHMS 后端 WebSocket 和 HTTP URL
CXO_GATEWAY_CXHMS_URL=ws://127.0.0.1:8000/ws
CXO_GATEWAY_CXHMS_HTTP_URL=http://127.0.0.1:8000

# ASR (语音识别) 服务 URL
CXO_GATEWAY_ASR_URL=http://127.0.0.1:8001

# TTS (语音合成) 服务 URL
CXO_GATEWAY_TTS_URL=http://127.0.0.1:8002

# Index-TTS 服务 URL
CXO_GATEWAY_INDEX_TTS_URL=http://127.0.0.1:8004

# ========================================
# 可选: 自定义配置文件路径
# ========================================
# CXO_GATEWAY_CONFIG=config.json
