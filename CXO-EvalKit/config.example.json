{
  "target": {
    "base_url": "http://host.docker.internal:8000",
    "admin_api_key": ""
  },
  "judge": {
    "api_base": "",
    "model": "",
    "api_key": "",
    "timeout_seconds": 60
  },
  "thresholds": {
    "memory": {
      "retention_1y_min": 0.6,
      "permanent_retention": 1.0,
      "reactivation_must_beat_control": true
