  "latency": {
    "rounds": 10,
    "probe_timeout_seconds": 120,
    "concurrency_levels": [1],
    "ws_full_duplex": {
      "enabled": true,
      "turns": 3,
      "utterance_wav": "",
      "frame_ms": 30,
      "turn_timeout_seconds": 90,
      "real_time_pacing": true
    }
  },
  "mock": {
    "enabled": false,
    "chat_delay_ms": 0
  },
  "data_dir": "data"
