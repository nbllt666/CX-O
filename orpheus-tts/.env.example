# ============================================================
# Orpheus TTS vLLM 服务环境变量配置
# 复制此文件为 .env 并根据需要修改
# ============================================================

# ---- 模型配置 ----
# HuggingFace 模型名称（多语言，含中文）
ORPHEUS_MODEL=canopylabs/orpheus-multilingual-research-release
# HuggingFace Token（如模型需要授权访问）
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# ---- GPU 资源分配 ----
# 物理 GPU ID（默认 1，即第二张卡；LLM 使用 0 卡）
ORPHEUS_GPU_ID=1
# 容器内 CUDA 可见设备编号（使用 device_ids 指定物理卡后，容器内从 0 开始编号）
ORPHEUS_CUDA_VISIBLE=0

# ---- vLLM 后端参数 ----
# vLLM 内部端口（容器间通信，无需对外暴露）
ORPHEUS_VLLM_PORT=8000
# 最大上下文长度
ORPHEUS_MAX_MODEL_LEN=4096
# GPU 显存利用率（Orpheus 3B 约 8-10GB，0.9 充裕）
ORPHEUS_GPU_MEM_UTIL=0.9
# 数据类型（auto/bfloat16/float16）
ORPHEUS_DTYPE=auto
# 最大并发序列数（TTS 生成长序列，建议小值）
ORPHEUS_MAX_NUM_SEQS=8

# ---- FastAPI Bridge 参数 ----
# 对外暴露的 TTS HTTP 端口
ORPHEUS_TTS_PORT=5060
# SNAC 解码器设备（cpu 避免 GPU 争抢；cuda 延迟更低）
ORPHEUS_SNAC_DEVICE=cpu

# ---- Orpheus 生成参数 ----
# 采样温度（0.6 为 Orpheus 推荐值）
ORPHEUS_TEMPERATURE=0.6
# Top-P 采样
ORPHEUS_TOP_P=0.95
# 最大生成 token 数（SNAC tokens，约每 7 个 token = 20ms 音频）
ORPHEUS_MAX_TOKENS=8192
