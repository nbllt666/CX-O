{
  "name": "cxo-neko-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "Neko 插件适配器：把 neko 插件服务器作为 sidecar 拉起，并把插件 LLM 工具桥接为 CXFC 协议供 CX-O 后端调用",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "node-forge": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-forge": "^1.3.14",
    "tsx": "^4.19.2",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
