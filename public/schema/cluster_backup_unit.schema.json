{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cx-o/public/schema/cluster_backup_unit.schema.json",
  "title": "ClusterBackupUnit",
  "description": "备份单元定义与同步进度契约。vector 不跨机同步（接收端本地重建）。",
  "type": "object",
  "required": ["unit", "strategy", "last_applied_seq"],
  "properties": {
    "unit": {
      "type": "string",
      "enum": ["memory", "persona", "config", "graph", "session", "autonomy", "vector"],
      "description": "备份单元名。"
    },
    "strategy": { "type": "string", "enum": ["incremental", "snapshot", "rebuild"], "description": "同步策略：增量事件流 / 定期快照 / 接收端重建（vector）。" },
    "last_applied_seq": { "type": "integer", "minimum": 0, "description": "已应用 seq（断线补传锚点）。" },
    "lag_events": { "type": "integer", "minimum": 0, "description": "待应用但未应用的事件数（同步延迟）。" },
    "last_snapshot_at": { "type": "string", "nullable": true, "description": "最近快照时间。" }
  }
}