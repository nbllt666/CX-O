{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cx-o/public/schema/speech_synthesis_response.schema.json",
  "title": "SpeechSynthesisResponse",
  "description": "统一 Qwen3 TTS 非流式合成响应契约。audio 为完整音频字节（base64），携带格式/采样率/时长元数据与 runtime（vLLM/官方运行时）标识。源真理：spec unify-qwen3-tts-migration 冻结决策。",
  "type": "object",
  "required": ["audio", "format", "sample_rate", "runtime"],
  "properties": {
    "audio": { "type": "string", "description": "合成音频 base64 编码（WAV/PCM 等，由 format 声明）。" },
    "format": { "type": "string", "enum": ["wav","pcm","mp3","flac","opus","aac"] },
    "sample_rate": { "type": "integer", "const": 24000 },
    "channels": { "type": "integer", "default": 1 },
    "duration_seconds": { "type": "number", "description": "音频时长（秒）。" },
    "refs_used": { "type": "array", "items": { "type": "string" }, "description": "本次合成实际使用的参考音频资产 ID。" },
    "runtime": { "type": "string", "enum": ["vllm","official_qwen3"], "description": "实际推理运行时。vllm 尚不支持的能力走 official_qwen3 临时路径，不得静默回退旧引擎。" },
    "error": { "$ref": "#/definitions/errorInfo", "description": "失败时的错误信息（可选）。" }
  },
  "definitions": {
    "errorInfo": {
      "type": "object",
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "description": "统一错误码（见 qwen3_tts_error_codes.json）。" },
        "message": { "type": "string" }
      }
    }
  }
}