{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cx-o/public/config_template/qwen3_tts_config.schema.json",
  "title": "Qwen3TTSConfig",
  "description": "统一 Qwen3 TTS 配置契约。含默认值、取值范围与缺失字段自动补齐(缺失字段按各属性 default 补齐，required 仅 enabled/runtime)。runtime 选择 vllm 首选；无参考音频的日常/情感合成由 vLLM VoiceDesign(task_type=VoiceDesign)承接，带参考音频的语音克隆由 IndexTTS-2.5(indextts 运行时)承接。旧引擎配置(f5_tts/orpheus/cosyvoice/emotion_refs)不再作为可选引擎，加载时映射 LEGACY_ENGINE_REMOVED。源真理：spec unify-qwen3-tts-migration 冻结决策 + s0601 契约变更(VoiceDesign+IndexTTS 架构)。",
  "type": "object",
  "properties": {
    "enabled": { "type": "boolean", "default": true },
    "runtime": { "type": "string", "enum": ["vllm"], "default": "vllm", "description": "首选运行时。vllm 为唯一首选；带 refs 时自动路由 indextts 克隆运行时。" },
    "vllm": {
      "type": "object",
      "description": "vLLM-Omni VoiceDesign 运行时：无参考音频的日常/情感合成。",
      "properties": {
        "base_url": { "type": "string", "default": "http://127.0.0.1:8091", "description": "vLLM-Omni /v1/audio/speech 基础地址。" },
        "model": { "type": "string", "default": "Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign", "description": "模型名/路径。" },
        "task_type": { "type": "string", "enum": ["VoiceDesign"], "default": "VoiceDesign" },
        "timeout_seconds": { "type": "number", "minimum": 1, "default": 60 },
        "sample_rate": { "type": "integer", "const": 24000 }
      },
      "required": ["base_url", "model"]
    },
    "indextts": {
      "type": "object",
      "description": "IndexTTS-2.5 克隆运行时：带参考音频的语音克隆。base_url 为空则禁用克隆能力，携带 refs 的请求抛 RuntimeUnsupportedError。",
      "properties": {
        "base_url": { "type": "string", "default": "http://127.0.0.1:8092", "description": "IndexTTS-2.5 OpenAI 兼容 /v1/audio/speech 基础地址。" },
        "model": { "type": "string", "default": "IndexTTS-2.5" },
        "timeout_seconds": { "type": "number", "minimum": 1, "default": 120 },
        "sample_rate": { "type": "integer", "const": 24000 }
      },
      "required": ["base_url", "model"]
    },
    "default": {
      "type": "object",
      "properties": {
        "voice": { "type": "string", "default": "vivian" },
        "language": { "type": "string", "default": "" },
        "output_format": { "type": "string", "enum": ["wav","pcm","mp3","flac","opus","aac"], "default": "wav" },
        "speed": { "type": "number", "minimum": 0.25, "maximum": 4.0, "default": 1.0 }
      }
    },
    "emotion_instruction": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "max_length": { "type": "integer", "default": 200 },
        "fallback_neutral": { "type": "boolean", "default": true }
      }
    },
    "legacy_engine_removed": {
      "type": "object",
      "description": "旧引擎配置不再作为可选引擎；加载含 f5_tts/orpheus/cosyvoice/emotion_refs 时映射 LEGACY_ENGINE_REMOVED。",
      "properties": {
        "return_removed_error": { "type": "boolean", "default": true }
      }
    }
  },
  "required": ["enabled", "runtime"]
}