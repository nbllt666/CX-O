# CX-O VoiceWorkStation 构建上下文忽略清单
# change-id: organize-per-service-docker-deploy（Task 3）
#
# 镜像只 COPY workstation/ 与 requirements.txt，本清单用于缩小构建上下文，
# 避免把本机数据、第三方引擎与 Windows 专用工具链打进上下文/镜像。

# 运行时数据与日志（由 compose 卷挂载覆盖）
data/
logs/

# 测试与缓存
tests/
.pytest_cache/
__pycache__/
*.pyc
htmlcov/
.coverage

# 本机日志（round*_vws_*.log 等一次性产物）
*.log

# 第三方分离引擎（demucs / AudioSep 仓库与权重，外部挂载，不进镜像）
engines/

# Windows 专用自包含 FFmpeg（full-shared DLL，约 178MB）；Linux 镜像用 apt ffmpeg
tools/ffmpeg/

# 本地虚拟环境
.venv-*/

# 保留：workstation/ 与 requirements.txt（Dockerfile 显式 COPY，不被本清单排除）
