# ============================================================
# CXO-Pet 渲染层环境变量示例
# 复制为 .env 后按需修改；所有变量均以 VITE_ 前缀暴露给渲染进程
# ============================================================

# 后端 HTTP API 地址（分离部署时填写远端地址）
# 开发模式下 vite dev server 会将 /api 代理到该地址
VITE_API_URL=http://127.0.0.1:8000

# 后端 WebSocket 地址
# 缺省时由 VITE_API_URL 自动推导（http→ws / https→wss）
# VITE_WS_URL=ws://127.0.0.1:8000
