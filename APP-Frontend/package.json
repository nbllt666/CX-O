{
  "name": "cxo-pet-app",
  "version": "0.1.0",
  "description": "CXO-Pet - 桌宠优先的桌面应用（Electron + React + Vite）",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "cross-env ELECTRON=true vite",
    "dev:browser": "vite",
    "build": "cross-env ELECTRON=true vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@pixi/constants": "^6.5.10",
    "@pixi/core": "^6.5.10",
    "@pixi/display": "^6.5.10",
    "@pixi/extensions": "^6.5.10",
    "@pixi/loaders": "^6.5.10",
    "@pixi/math": "^6.5.10",
    "@pixi/runner": "^6.5.10",
    "@pixi/settings": "^6.5.10",
    "@pixi/sprite": "^6.5.10",
    "@pixi/ticker": "^6.5.10",
    "@pixi/utils": "^6.5.10",
    "@pixiv/three-vrm": "^3.5.2",
    "@types/three": "^0.184.0",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "i18next": "^25.8.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.469.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.6.0",
    "three": "^0.184.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^17.3.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.54.0",
    "vite": "^6.0.6",
    "vite-plugin-electron": "^1.0.4",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "vite": "^6.0.6"
  }
}
