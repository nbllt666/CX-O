# CX-O Frontend Environment Configuration
# 复制此文件为 .env 并根据实际情况修改

# API 服务地址（Gateway 端口）
VITE_API_URL=http://localhost:8100

# WebSocket 服务地址
VITE_WS_URL=ws://localhost:8100

# 控制服务地址
VITE_CONTROL_SERVICE_URL=http://localhost:8765

# 可选：超时配置（秒）
VITE_REQUEST_TIMEOUT=30

# 可选：日志级别
VITE_LOG_LEVEL=info
